{"created": "2025-11-13T21:56:29.782683+00:00", "modified": "2025-12-22T11:16:33.351116+00:00", "id": 17604565, "conceptrecid": "15147435", "doi": "10.5281/zenodo.17604565", "conceptdoi": "10.5281/zenodo.15147435", "doi_url": "https://doi.org/10.5281/zenodo.17604565", "metadata": {"title": "The London Register of Subsurface CO\u2082 Storage", "doi": "10.5281/zenodo.17604565", "publication_date": "2025-11-12", "description": "<p>This Register is a centralised record of annual rates of CO\u2082 stored underground at operational projects worldwide. Funded by the UK Royal Academy of Engineering and supported by a consortium of partners from academia, industry, and government, it combines data reported directly by operators with information from public sources to provide a standardised account of annual CO\u2082 storage. Please contact us with any questions or interest in the project.</p>\n<p><strong>The 2025 release includes:</strong></p>\n<ul>\n<li>\n<p><strong>Annual Report 2025</strong> &mdash; A narrative summary of the data in the Register.</p>\n</li>\n<li>\n<p><strong>The London Register of Subsurface CO\u2082 Storage</strong> &mdash; The full database in <em>.xls</em> format.</p>\n</li>\n<li>\n<p><strong>Data Assurance</strong> &mdash; An independent assurance evaluation carried out by DNV will be available here in December.</p>\n</li>\n</ul>\n<p><strong>Suggested citation</strong></p>\n<p>Gao, X., &amp; Krevor, S. (2025). <em>The London Register of Subsurface CO\u2082 Storage: 2025 Annual Report</em>. Imperial College London.</p>\n<p>All materials were updated on <strong>12 November 2025</strong>.</p>", "access_right": "restricted", "creators": [{"name": "GAO, Xiaowei", "affiliation": "Imperial College London, Department of Earth Science and Engineering", "orcid": "0000-0003-3273-7499"}, {"name": "Krevor, Samuel", "affiliation": "Imperial College London", "orcid": "0000-0001-6106-0734"}], "resource_type": {"title": "Publication", "type": "publication"}, "license": {"id": "cc-by-4.0"}, "grants": [{"code": "RCSRF2223-1677", "internal_id": "0526snb40::RCSRF2223-1677", "funder": {"name": "Royal Academy of Engineering"}, "title": "Senior Research Fellowship"}], "relations": {"version": [{"index": 5, "is_last": false, "parent": {"pid_type": "recid", "pid_value": "15147435"}}]}}, "title": "The London Register of Subsurface CO\u2082 Storage", "links": {"self": "https://zenodo.org/api/records/17604565", "self_html": "https://zenodo.org/records/17604565", "preview_html": "https://zenodo.org/records/17604565?preview=1", "doi": "https://doi.org/10.5281/zenodo.17604565", "self_doi": "https://doi.org/10.5281/zenodo.17604565", "self_doi_html": "https://zenodo.org/doi/10.5281/zenodo.17604565", "reserve_doi": "https://zenodo.org/api/records/17604565/draft/pids/doi", "parent": "https://zenodo.org/api/records/15147435", "parent_html": "https://zenodo.org/records/15147435", "parent_doi": "https://doi.org/10.5281/zenodo.15147435", "parent_doi_html": "https://zenodo.org/doi/10.5281/zenodo.15147435", "self_iiif_manifest": "https://zenodo.org/api/iiif/record:17604565/manifest", "self_iiif_sequence": "https://zenodo.org/api/iiif/record:17604565/sequence/default", "files": "https://zenodo.org/api/records/17604565/files", "media_files": "https://zenodo.org/api/records/17604565/media-files", "thumbnails": {"10": "https://zenodo.org/api/iiif/record:17604565:AnnualReport2025.pdf/full/%5E10,/0/default.jpg", "50": "https://zenodo.org/api/iiif/record:17604565:AnnualReport2025.pdf/full/%5E50,/0/default.jpg", "100": "https://zenodo.org/api/iiif/record:17604565:AnnualReport2025.pdf/full/%5E100,/0/default.jpg", "250": "https://zenodo.org/api/iiif/record:17604565:AnnualReport2025.pdf/full/%5E250,/0/default.jpg", "750": "https://zenodo.org/api/iiif/record:17604565:AnnualReport2025.pdf/full/%5E750,/0/default.jpg", "1200": "https://zenodo.org/api/iiif/record:17604565:AnnualReport2025.pdf/full/%5E1200,/0/default.jpg"}, "latest": "https://zenodo.org/api/records/176