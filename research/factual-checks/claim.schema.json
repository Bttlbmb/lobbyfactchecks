{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:lobby-fact-check:claim-assessment:1",
  "title": "Material factual claim assessment",
  "type": "object",
  "required": [
    "id",
    "document_id",
    "pdf_pages",
    "section",
    "original_excerpt",
    "claim_en",
    "claim_type",
    "materiality",
    "policy_link",
    "cited_by_author",
    "check_method",
    "evidence",
    "result",
    "explanation",
    "limits",
    "check_completed"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "document_id": {
      "type": "string",
      "minLength": 1
    },
    "pdf_pages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "integer",
        "minimum": 1
      }
    },
    "section": {
      "type": "string"
    },
    "original_excerpt": {
      "type": "string",
      "minLength": 1
    },
    "claim_en": {
      "type": "string",
      "minLength": 1
    },
    "claim_type": {
      "type": "string"
    },
    "materiality": {
      "enum": [
        "high",
        "medium",
        "low"
      ]
    },
    "policy_link": {
      "type": "string"
    },
    "cited_by_author": {
      "type": [
        "boolean",
        "string",
        "array",
        "null"
      ]
    },
    "check_method": {
      "type": [
        "string",
        "array"
      ]
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "source_id"
        ],
        "properties": {
          "source_id": {
            "type": "string"
          },
          "locator": {
            "type": [
              "string",
              "object",
              "array"
            ]
          },
          "summary": {
            "type": "string"
          }
        }
      }
    },
    "result": {
      "enum": [
        "supported",
        "contradicted",
        "overstated",
        "unresolved",
        "not_checked"
      ]
    },
    "explanation": {
      "type": "string",
      "minLength": 1
    },
    "limits": {
      "type": [
        "string",
        "array"
      ]
    },
    "check_completed": {
      "type": "boolean"
    }
  }
}
